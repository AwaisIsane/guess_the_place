POSTGRES_DB=worldguessr
POSTGRES_USER=worldguessr
POSTGRES_PASSWORD=replace-with-a-long-random-password
SIGNING_SECRET=replace-with-at-least-32-random-bytes
ENVIRONMENT=production
PUBLIC_DOMAIN=play.example.com
PUBLIC_ORIGIN=https://play.example.com
SITE_ADDRESS=https://play.example.com
HTTP_PORT=80
HTTPS_PORT=443

# Public, domain-restricted browser token and private server discovery token
MAPILLARY_CLIENT_TOKEN=
MAPILLARY_GRAPH_TOKEN=

# Use a production OSM-derived provider; do not use tile.openstreetmap.org at scale.
MAP_STYLE_URL=https://your-map-provider.example/style.json?key=replace-me
MAP_ATTRIBUTION=© OpenStreetMap contributors

COUNTRY_POOL_TARGET=200
COUNTRY_POOL_MINIMUM=25
ELIGIBLE_COUNTRY_MINIMUM=10
RATE_LIMIT_PER_MINUTE=120
ALLOW_DEMO_CATALOG=false
