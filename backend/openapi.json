{
  "components": {
    "schemas": {
      "Coordinate": {
        "properties": {
          "latitude": {
            "title": "Latitude",
            "type": "number"
          },
          "longitude": {
            "title": "Longitude",
            "type": "number"
          }
        },
        "required": [
          "latitude",
          "longitude"
        ],
        "title": "Coordinate",
        "type": "object"
      },
      "DependencyStatus": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "status": {
            "enum": [
              "up",
              "down"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "DependencyStatus",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "GameSummary": {
        "properties": {
          "game_id": {
            "format": "uuid",
            "title": "Game Id",
            "type": "string"
          },
          "maximum_score": {
            "default": 25000,
            "title": "Maximum Score",
            "type": "integer"
          },
          "rounds": {
            "items": {
              "$ref": "#/components/schemas/SummaryRound"
            },
            "title": "Rounds",
            "type": "array"
          },
          "total_score": {
            "title": "Total Score",
            "type": "integer"
          }
        },
        "required": [
          "game_id",
          "total_score",
          "rounds"
        ],
        "title": "GameSummary",
        "type": "object"
      },
      "GameView": {
        "properties": {
          "current_round": {
            "title": "Current Round",
            "type": "integer"
          },
          "game_id": {
            "format": "uuid",
            "title": "Game Id",
            "type": "string"
          },
          "round": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RoundView"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "active",
              "complete",
              "expired"
            ],
            "title": "Status",
            "type": "string"
          },
          "total_score": {
            "title": "Total Score",
            "type": "integer"
          }
        },
        "required": [
          "game_id",
          "status",
          "current_round",
          "total_score",
          "round"
        ],
        "title": "GameView",
        "type": "object"
      },
      "GuessIn": {
        "properties": {
          "latitude": {
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude",
            "type": "number"
          },
          "longitude": {
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude",
            "type": "number"
          }
        },
        "required": [
          "latitude",
          "longitude"
        ],
        "title": "GuessIn",
        "type": "object"
      },
      "GuessResult": {
        "properties": {
          "actual": {
            "$ref": "#/components/schemas/Coordinate"
          },
          "distance_km": {
            "title": "Distance Km",
            "type": "number"
          },
          "game_complete": {
            "title": "Game Complete",
            "type": "boolean"
          },
          "guess": {
            "$ref": "#/components/schemas/Coordinate"
          },
          "round": {
            "title": "Round",
            "type": "integer"
          },
          "score": {
            "title": "Score",
            "type": "integer"
          },
          "total_score": {
            "title": "Total Score",
            "type": "integer"
          }
        },
        "required": [
          "round",
          "distance_km",
          "score",
          "total_score",
          "guess",
          "actual",
          "game_complete"
        ],
        "title": "GuessResult",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PublicConfig": {
        "properties": {
          "map_attribution": {
            "title": "Map Attribution",
            "type": "string"
          },
          "map_style_url": {
            "title": "Map Style Url",
            "type": "string"
          },
          "mapillary_client_token": {
            "title": "Mapillary Client Token",
            "type": "string"
          },
          "rounds_per_game": {
            "default": 5,
            "title": "Rounds Per Game",
            "type": "integer"
          }
        },
        "required": [
          "mapillary_client_token",
          "map_style_url",
          "map_attribution"
        ],
        "title": "PublicConfig",
        "type": "object"
      },
      "Readiness": {
        "properties": {
          "dependencies": {
            "additionalProperties": {
              "$ref": "#/components/schemas/DependencyStatus"
            },
            "title": "Dependencies",
            "type": "object"
          },
          "status": {
            "enum": [
              "ready",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "dependencies"
        ],
        "title": "Readiness",
        "type": "object"
      },
      "RoundView": {
        "properties": {
          "compass_angle": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Compass Angle"
          },
          "image_id": {
            "title": "Image Id",
            "type": "string"
          },
          "number": {
            "title": "Number",
            "type": "integer"
          },
          "sequence_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sequence Id"
          }
        },
        "required": [
          "number",
          "image_id"
        ],
        "title": "RoundView",
        "type": "object"
      },
      "SummaryRound": {
        "properties": {
          "actual": {
            "$ref": "#/components/schemas/Coordinate"
          },
          "distance_km": {
            "title": "Distance Km",
            "type": "number"
          },
          "guess": {
            "$ref": "#/components/schemas/Coordinate"
          },
          "round": {
            "title": "Round",
            "type": "integer"
          },
          "score": {
            "title": "Score",
            "type": "integer"
          }
        },
        "required": [
          "round",
          "score",
          "distance_km",
          "guess",
          "actual"
        ],
        "title": "SummaryRound",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Five-round guest geography game API.",
    "title": "WorldGuessr API",
    "version": "1.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/config": {
      "get": {
        "operationId": "config_api_v1_config_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicConfig"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Config",
        "tags": [
          "game"
        ]
      }
    },
    "/api/v1/games": {
      "post": {
        "operationId": "new_game_api_v1_games_post",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameView"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "New Game",
        "tags": [
          "game"
        ]
      }
    },
    "/api/v1/games/{game_id}": {
      "get": {
        "operationId": "get_game_api_v1_games__game_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "game_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Game Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameView"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Gone"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Game",
        "tags": [
          "game"
        ]
      }
    },
    "/api/v1/games/{game_id}/rounds/{number}/guess": {
      "post": {
        "operationId": "guess_api_v1_games__game_id__rounds__number__guess_post",
        "parameters": [
          {
            "in": "path",
            "name": "game_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Game Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "number",
            "required": true,
            "schema": {
              "title": "Number",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GuessIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuessResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Gone"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Guess",
        "tags": [
          "game"
        ]
      }
    },
    "/api/v1/games/{game_id}/summary": {
      "get": {
        "operationId": "summary_api_v1_games__game_id__summary_get",
        "parameters": [
          {
            "in": "path",
            "name": "game_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Game Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Gone"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Summary",
        "tags": [
          "game"
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "operations"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
        "tags": [
          "operations"
        ]
      }
    },
    "/metrics": {
      "get": {
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response"
          }
        },
        "summary": "Metrics",
        "tags": [
          "operations"
        ]
      }
    }
  }
}
